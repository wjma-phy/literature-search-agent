{
  "name": "dsh-literature-search",
  "version": "0.1.0",
  "description": "DSH web 插件：文献检索面板（侧边栏入口 + 浮动面板），进程内调用 literature-search-agent core（OpenAlex 检索/去重/节流）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/vendor/lit-core.bundle.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT"
}
